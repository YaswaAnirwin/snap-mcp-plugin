{
  "name": "snap-code-plugin",
  "displayName": "Snap Code Plugin (MCP Manager)",
  "description": "Auto-connects to Azure DevOps and Figma MCP servers, fetches PBIs, and generates React/Python code via Copilot Chat.",
  "version": "0.0.2",
  "publisher": "snap",
  "type": "module",
  "engines": {
    "vscode": "^1.105.0"
  },
  "categories": [
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onChatParticipant:snap-code-plugin.snap"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "snap-code-plugin.setupMCP",
        "title": "MCP: Setup Servers"
      },
      {
        "command": "snap-code-plugin.showMCPStatus",
        "title": "MCP: Show Status"
      },
      {
        "command": "snap-code-plugin.disconnectMCP",
        "title": "MCP: Disconnect All Servers"
      },
      {
        "command": "snap-code-plugin.configureMCP",
        "title": "MCP: Configure Credentials"
      },
      {
        "command": "snap-code-plugin.configureNativeIntegration",
        "title": "Snap: Configure Native Copilot Integration"
      }
    ],
    "chatParticipants": [
      {
        "id": "snap-code-plugin.snap",
        "name": "snap",
        "description": "Enhanced Copilot that fetches Azure DevOps PBIs, analyzes Figma links, and generates production-ready code automatically.",
        "isSticky": true,
        "commands": [
          {
            "name": "azure",
            "description": "Query Azure DevOps work items, pull requests, and repositories"
          },
          {
            "name": "figma",
            "description": "Query Figma designs, components, and files"
          },
          {
            "name": "status",
            "description": "Show status of all connected MCP servers"
          }
        ]
      }
    ],
    "configuration": {
      "title": "MCP Manager",
      "properties": {
        "mcpManager.azureDevOps.pat": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Personal Access Token",
          "scope": "application"
        },
        "mcpManager.azureDevOps.organization": {
          "type": "string",
          "default": "",
          "description": "Azure DevOps Organization URL",
          "scope": "application"
        },
        "mcpManager.figma.accessToken": {
          "type": "string",
          "default": "",
          "description": "Figma Access Token",
          "scope": "application"
        },
        "mcpManager.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "Automatically connect to MCP servers on startup"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.cjs",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.cjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.cjs --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "instructions-mcp": "node ./mcp/instructions-mcp.js"
  },
  "devDependencies": {
    "@types/dotenv": "^6.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.105.0",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.45.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "^1.21.1",
    "dotenv": "^17.2.3",
    "node-fetch": "^3.3.2"
  }
}
